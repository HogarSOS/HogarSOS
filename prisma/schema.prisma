generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id                       String           @id @default(uuid())
  email                    String           @unique
  telefono                 String?
  nombre                   String
  role                     UserRole         @default(cliente)
  firebaseUid              String?          @unique @map("firebase_uid")
  fcmToken                 String?          @map("fcm_token")
  fotoPerfilUrl            String?          @map("foto_perfil_url")
  valoracionMedia          Decimal          @default(0.00) @map("valoracion_media")
  totalValoraciones        Int              @default(0) @map("total_valoraciones")
  activo                   Boolean          @default(true)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  professional             Professional?
  reviewsEscritas          Review[]         @relation("AutorReview")
  reviewsRecibidas         Review[]         @relation("DestinatarioReview")
  serviceRequestsAsCliente ServiceRequest[] @relation("ClienteRequests")

  @@map("users")
}

model ServiceCategory {
  id              Int                    @id @default(autoincrement())
  nombre          String                 @unique
  descripcion     String?
  iconoUrl        String?                @map("icono_url")
  activo          Boolean                @default(true)
  professionals   ProfessionalCategory[]
  serviceRequests ServiceRequest[]

  @@map("service_categories")
}

model Professional {
  userId                String                    @id @map("user_id")
  documentoIdentidadUrl String                    @map("documento_identidad_url")
  certificadosUrl       String[]                  @map("certificados_url")
  seguroRcUrl           String?                   @map("seguro_rc_url")
  estadoVerificacion    EstadoVerificacion        @default(pendiente) @map("estado_verificacion")
  tarifaBase            Decimal                   @map("tarifa_base")
  valoracionMedia       Decimal                   @default(0.00) @map("valoracion_media")
  totalTrabajos         Int                       @default(0) @map("total_trabajos")
  disponible            Boolean                   @default(false)
  modoDisponibilidad    ModoDisponibilidad        @default(horario_laboral) @map("modo_disponibilidad")
  stripeAccountId       String?                   @map("stripe_account_id")
  verificadoPor         String?                   @map("verificado_por")
  verificadoAt          DateTime?                 @map("verificado_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  zonaTrabajo           Unsupported("geography")? @map("zona_trabajo")
  ubicacionActual       Unsupported("geography")? @map("ubicacion_actual")
  descripcion           String?
  fotoPerfilUrl         String?                   @map("foto_perfil_url")
  categorias            ProfessionalCategory[]
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests       ServiceRequest[]
  postulaciones         Postulacion[]
  presupuestos          Presupuesto[]

  @@index([ubicacionActual], map: "idx_professionals_ubicacion_actual", type: Gist)
  @@map("professionals")
}

model ProfessionalCategory {
  professionalId String          @map("professional_id")
  categoryId     Int             @map("category_id")
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  professional   Professional    @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  @@id([professionalId, categoryId])
  @@map("professional_categories")
}

model ServiceRequest {
  id             String                   @id @default(uuid())
  clienteId      String                   @map("cliente_id")
  profesionalId  String?                  @map("profesional_id")
  categoryId     Int                      @map("category_id")
  descripcion    String
  fotoUrl        String?                  @map("foto_url")
  fotosUrls      String[]                 @default([]) @map("fotos_urls")
  ubicacion      Unsupported("geography")
  direccionTexto String?                  @map("direccion_texto")
  urgencia       UrgenciaSolicitud        @default(lo_antes_posible)
  fechaDeseada   DateTime?                @map("fecha_deseada")
  precioFinal    Decimal?                 @map("precio_final")
  estado         EstadoSolicitud          @default(pendiente)
  createdAt      DateTime                 @default(now()) @map("created_at")
  aceptadaAt     DateTime?                @map("aceptada_at")
  completadaAt   DateTime?                @map("completada_at")
  disputes       Dispute[]
  payment        Payment?
  reviews        Review[]
  postulaciones  Postulacion[]
  presupuestos   Presupuesto[]
  categoria      ServiceCategory          @relation(fields: [categoryId], references: [id])
  cliente        User                     @relation("ClienteRequests", fields: [clienteId], references: [id])
  profesional    Professional?            @relation(fields: [profesionalId], references: [userId])

  @@index([ubicacion], map: "idx_service_requests_ubicacion", type: Gist)
  @@map("service_requests")
}

model Payment {
  id                    String         @id @default(uuid())
  serviceRequestId      String         @unique @map("service_request_id")
  montoTotal            Decimal        @map("monto_total")
  comisionPlataforma    Decimal        @map("comision_plataforma")
  montoProfesional      Decimal        @map("monto_profesional")
  estado                EstadoPago     @default(retenido)
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id")
  stripeTransferId      String?        @map("stripe_transfer_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  liberadoAt            DateTime?      @map("liberado_at")
  serviceRequest        ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@map("payments")
}

// Bidireccional: cliente -> profesional y profesional -> cliente son
// dos filas independientes de la misma solicitud, una por cada
// "autor". El único constraint que tiene sentido ya no es
// serviceRequestId a secas (eso permitía solo UNA valoración total
// por solicitud) sino (serviceRequestId, autorId): cada parte puede
// valorar como mucho una vez, en su propio sentido.
model Review {
  id               String         @id @default(uuid())
  serviceRequestId String         @map("service_request_id")
  autorId          String         @map("autor_id")
  destinatarioId   String         @map("destinatario_id")
  puntuacion       Int
  comentario       String?
  createdAt        DateTime       @default(now()) @map("created_at")
  autor            User           @relation("AutorReview", fields: [autorId], references: [id])
  destinatario     User           @relation("DestinatarioReview", fields: [destinatarioId], references: [id])
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@unique([serviceRequestId, autorId])
  @@map("reviews")
}

model Dispute {
  id               String            @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  creadoPor        String            @map("creado_por")
  motivo           String
  motivoCategoria  MotivoReclamacion @default(otro) @map("motivo_categoria")
  fotosUrls        String[]          @default([]) @map("fotos_urls")
  estado           String            @default("abierta")
  resueltoPor      String?           @map("resuelto_por")
  resolucionNotas  String?           @map("resolucion_notas")
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id])

  @@map("disputes")
}

// Candidatura de un profesional a una solicitud "pendiente" — sustituye
// al antiguo "el primero que acepta gana". Único por (solicitud,
// profesional), mismo patrón que Review, para que no pueda postularse
// dos veces a la misma solicitud.
model Postulacion {
  id               String            @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  profesionalId    String            @map("profesional_id")
  mensaje          String?
  estado           EstadoPostulacion @default(pendiente)
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id])
  profesional      Professional      @relation(fields: [profesionalId], references: [userId])

  @@unique([serviceRequestId, profesionalId])
  @@map("postulaciones")
}

// Presupuesto real que el profesional envía tras ser elegido — sustituye
// al antiguo precioEstimado (adivinado por el cliente al crear la
// solicitud, nunca acordado con nadie). Dos modalidades: precio cerrado
// (monto fijo) o por horas (tarifa × horas estimadas, el importe que se
// autoriza en Stripe es ese techo). Sin @@unique a propósito, a
// diferencia de Postulacion: puede haber varias filas para el mismo
// profesional si el cliente rechaza una y llega una nueva — el control
// de "solo un pendiente a la vez" se hace en el controlador, no aquí.
model Presupuesto {
  id               String            @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  profesionalId    String            @map("profesional_id")
  tipo             TipoPresupuesto
  monto            Decimal? // solo tipo=cerrado
  tarifaHora       Decimal?          @map("tarifa_hora") // solo tipo=por_horas
  horasEstimadas   Decimal?          @map("horas_estimadas") // solo tipo=por_horas
  mensaje          String?
  estado           EstadoPresupuesto @default(pendiente)
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id])
  profesional      Professional      @relation(fields: [profesionalId], references: [userId])

  @@index([serviceRequestId, estado])
  @@map("presupuestos")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  cliente
  profesional
  admin
}

enum EstadoVerificacion {
  pendiente
  aprobado
  rechazado
}

enum EstadoSolicitud {
  pendiente
  aceptada
  en_progreso
  completada
  cancelada
  disputada
}

enum EstadoPago {
  retenido
  liberado
  reembolsado
  fallido
}

enum UrgenciaSolicitud {
  lo_antes_posible
  hoy
  manana
  fecha_especifica
}

enum EstadoPostulacion {
  pendiente
  aceptada
  rechazada
}

enum TipoPresupuesto {
  cerrado
  por_horas
}

enum EstadoPresupuesto {
  pendiente
  aceptado
  rechazado
}

// Motivos fijos de reclamación — lista cerrada a propósito (en vez de
// texto libre) para que el panel de admin pueda filtrar/agrupar por
// motivo real; la descripción libre va aparte, en Dispute.motivo.
enum MotivoReclamacion {
  profesional_no_presento
  cliente_ausente
  trabajo_cancelado
  problema_pago
  comportamiento_inapropiado
  otro
}

// Modo de disponibilidad declarado por el profesional (no es lo mismo
// que "disponible", que es si está aceptando trabajos AHORA MISMO).
// Deliberadamente solo dos opciones en esta primera versión — sin
// calendario ni horarios personalizados — pero como enum queda
// preparado para añadir variantes futuras sin tocar el tipo de columna.
enum ModoDisponibilidad {
  horario_laboral
  veinticuatro_horas
}
