generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id                       String           @id @default(uuid())
  // Opcional a propósito: una cuenta puede registrarse solo con
  // teléfono (ver telefono más abajo) — la validación de "tiene que
  // haber email O teléfono" vive en auth.controller.ts, no aquí.
  email                    String?          @unique
  telefono                 String?          @unique
  nombre                   String
  role                     UserRole         @default(cliente)
  firebaseUid              String?          @unique @map("firebase_uid")
  fcmToken                 String?          @map("fcm_token")
  // Idioma preferido para las notificaciones push — se actualiza solo
  // (sin acción del usuario) desde el dispositivo en cada arranque con
  // sesión activa, igual que fcmToken (ver PATCH /auth/me/idioma), a
  // partir del locale del sistema que ya resuelve MaterialApp en el
  // frontend. Por defecto 'es' porque es el idioma con el que arrancó
  // la app antes de añadir soporte a inglés.
  idioma                   Idioma           @default(es)
  fotoPerfilUrl            String?          @map("foto_perfil_url")
  // Solo se usa para clientes (Customer de Stripe para recordar tarjetas
  // vía Payment Sheet con Ephemeral Key) — se crea de forma perezosa en
  // el primer pago, no al registrarse.
  stripeCustomerId         String?          @map("stripe_customer_id")
  valoracionMedia          Decimal          @default(0.00) @map("valoracion_media")
  totalValoraciones        Int              @default(0) @map("total_valoraciones")
  activo                   Boolean          @default(true)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  professional             Professional?
  reviewsEscritas          Review[]         @relation("AutorReview")
  reviewsRecibidas         Review[]         @relation("DestinatarioReview")
  serviceRequestsAsCliente ServiceRequest[] @relation("ClienteRequests")
  archivos                 ArchivoSubido[]

  @@map("users")
}

model ServiceCategory {
  id              Int                    @id @default(autoincrement())
  nombre          String                 @unique
  descripcion     String?
  iconoUrl        String?                @map("icono_url")
  activo          Boolean                @default(true)
  professionals   ProfessionalCategory[]
  serviceRequests ServiceRequest[]

  @@map("service_categories")
}

model Professional {
  userId                String                    @id @map("user_id")
  documentoIdentidadUrl String?                   @map("documento_identidad_url")
  certificadosUrl       String[]                  @map("certificados_url")
  seguroRcUrl           String?                   @map("seguro_rc_url")
  estadoVerificacion    EstadoVerificacion        @default(pendiente) @map("estado_verificacion")
  // Nullable a propósito: los profesionales ya registrados antes de
  // este campo no tienen uno todavía — se pide al completar perfil
  // (submitVerificationDocs), no en el registro inicial.
  tipoProfesional       TipoProfesional?          @map("tipo_profesional")
  tarifaBase            Decimal                   @map("tarifa_base")
  valoracionMedia       Decimal                   @default(0.00) @map("valoracion_media")
  totalTrabajos         Int                       @default(0) @map("total_trabajos")
  disponible            Boolean                   @default(false)
  modoDisponibilidad    ModoDisponibilidad        @default(horario_laboral) @map("modo_disponibilidad")
  stripeAccountId       String?                   @map("stripe_account_id")
  stripeDetailsSubmitted Boolean                  @default(false) @map("stripe_details_submitted")
  stripeChargesEnabled  Boolean                   @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled  Boolean                   @default(false) @map("stripe_payouts_enabled")
  verificadoPor         String?                   @map("verificado_por")
  verificadoAt          DateTime?                 @map("verificado_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  zonaTrabajo           Unsupported("geography")? @map("zona_trabajo")
  ubicacionActual       Unsupported("geography")? @map("ubicacion_actual")
  descripcion           String?
  fotoPerfilUrl         String?                   @map("foto_perfil_url")
  categorias            ProfessionalCategory[]
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests       ServiceRequest[]
  postulaciones         Postulacion[]
  presupuestos          Presupuesto[]

  @@index([ubicacionActual], map: "idx_professionals_ubicacion_actual", type: Gist)
  // disponible y estadoVerificacion: filtrados en CADA búsqueda de
  // profesionales cercanos (searchProfessionals) y en el aviso a
  // profesionales cercanos al crear una solicitud (notificarProfesionalesCercanos)
  // — sin índice, ambos filtros caían en sequential scan sobre toda la
  // tabla professionals en cuanto creciera más allá de un puñado de filas.
  @@index([disponible])
  @@index([estadoVerificacion])
  @@map("professionals")
}

model ProfessionalCategory {
  professionalId String          @map("professional_id")
  categoryId     Int             @map("category_id")
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  professional   Professional    @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  @@id([professionalId, categoryId])
  // La PK (professionalId, categoryId) no sirve para buscar por
  // categoryId sola (no es la columna líder) — y notificarProfesionalesCercanos
  // hace justo eso en cada solicitud nueva (JOIN ... WHERE pc.category_id = X).
  @@index([categoryId])
  @@map("professional_categories")
}

model ServiceRequest {
  id             String                   @id @default(uuid())
  clienteId      String                   @map("cliente_id")
  profesionalId  String?                  @map("profesional_id")
  categoryId     Int                      @map("category_id")
  descripcion    String
  fotoUrl        String?                  @map("foto_url")
  fotosUrls      String[]                 @default([]) @map("fotos_urls")
  ubicacion      Unsupported("geography")
  direccionTexto String?                  @map("direccion_texto")
  urgencia       UrgenciaSolicitud        @default(lo_antes_posible)
  fechaDeseada   DateTime?                @map("fecha_deseada")
  precioFinal    Decimal?                 @map("precio_final")
  estado         EstadoSolicitud          @default(pendiente)
  createdAt      DateTime                 @default(now()) @map("created_at")
  aceptadaAt     DateTime?                @map("aceptada_at")
  // Cuándo el profesional pulsó "Iniciar trabajo" (aceptada -> en_progreso).
  // Null si nunca se activó, o si se deshizo con "Deshacer inicio" — el
  // hecho de que sea reversible es justo lo que impide que este campo por
  // sí solo sirva como prueba legal, pero ayuda al admin a ver cuándo
  // ocurrió en una disputa.
  iniciadoAt     DateTime?                @map("iniciado_at")
  completadaAt   DateTime?                @map("completada_at")
  // Ocultar de la lista de cada parte sin borrar nada (pagos/chat/
  // reviews se conservan) — independientes porque cliente y profesional
  // pueden querer "limpiar" su propia lista en momentos distintos.
  archivadoCliente     Boolean            @default(false) @map("archivado_cliente")
  archivadoProfesional Boolean            @default(false) @map("archivado_profesional")
  disputes       Dispute[]
  pagos          Payment[]
  reviews        Review[]
  postulaciones  Postulacion[]
  presupuestos   Presupuesto[]
  cierresHoras   CierreHoras[]
  categoria      ServiceCategory          @relation(fields: [categoryId], references: [id])
  cliente        User                     @relation("ClienteRequests", fields: [clienteId], references: [id])
  profesional    Professional?            @relation(fields: [profesionalId], references: [userId])

  @@index([ubicacion], map: "idx_service_requests_ubicacion", type: Gist)
  // clienteId/profesionalId: sin índice, "mis solicitudes" (cliente) y
  // "mis trabajos asignados" (profesional) hacían sequential scan sobre
  // toda la tabla — esta segunda además se sondea cada 10s desde
  // home_profesional_screen.dart mientras la pestaña está abierta, la
  // consulta más frecuente de toda la app.
  @@index([clienteId])
  @@index([profesionalId])
  // (estado, categoryId): cubre la otra consulta sondeada cada 10s —
  // solicitudes pendientes cercanas de la categoría del profesional
  // (notificarProfesionalesCercanos / listNearbyRequests). Se combina
  // con el índice espacial GiST de arriba vía bitmap AND.
  @@index([estado, categoryId])
  @@map("service_requests")
}

// Ya no es 1:1 con ServiceRequest (sin @unique en serviceRequestId):
// puede haber varias filas — la autorización inicial (ampliacionId
// null) más una por cada ampliación de horas aceptada. presupuestoId
// deja rastro de a qué presupuesto pertenece cada autorización, para
// poder sumarlas todas al calcular cuánto hay realmente retenido.
model Payment {
  id                    String         @id @default(uuid())
  serviceRequestId      String         @map("service_request_id")
  presupuestoId         String         @map("presupuesto_id")
  ampliacionId          String?        @map("ampliacion_id")
  montoBase             Decimal        @map("monto_base")
  montoTotal            Decimal        @map("monto_total")
  comisionPlataforma    Decimal        @map("comision_plataforma")
  montoProfesional      Decimal        @map("monto_profesional")
  estado                EstadoPago     @default(retenido)
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id")
  stripeTransferId      String?        @map("stripe_transfer_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  liberadoAt            DateTime?      @map("liberado_at")

  // --- Liberación en dos fases (captura -> transferencia) ---
  //
  // releasePayments hace tres efectos por fila que no pueden ser
  // atómicos entre sí (capture en Stripe, transfer en Stripe, escritura
  // aquí). Estas columnas son el registro write-ahead que permite saber
  // en cuál de los tres se quedó si el proceso muere en medio, y
  // reanudar sin repetir lo ya hecho ni perder el dinero capturado.
  //
  // El PLAN (cuánto de esta autorización se va a consumir) se congela
  // aquí ANTES de llamar a Stripe. Es deliberadamente independiente de
  // montoBase/montoTotal/montoProfesional, que siguen guardando lo
  // AUTORIZADO y no se tocan hasta el final: si se sobrescribieran al
  // empezar, un reintento ya no tendría con qué re-planificar.
  capturadoBase         Decimal?       @map("capturado_base")
  capturadoTotal        Decimal?       @map("capturado_total")
  capturadoProfesional  Decimal?       @map("capturado_profesional")
  // El ch_... que devuelve la captura. Imprescindible para el
  // source_transaction del transfer si hay que reintentar en otra
  // ejecución distinta a la que capturó.
  stripeChargeId        String?        @map("stripe_charge_id")
  capturadoAt           DateTime?      @map("capturado_at")
  // Lease de exclusión mutua entre ejecuciones concurrentes de
  // releasePayments sobre la misma solicitud. Con expiración (no es un
  // lock permanente) para que un reinicio de Render en pleno vuelo no
  // deje el pago bloqueado para siempre.
  liberacionEnCursoAt   DateTime?      @map("liberacion_en_curso_at")
  intentosLiberacion    Int            @default(0) @map("intentos_liberacion")
  ultimoErrorLiberacion String?        @map("ultimo_error_liberacion")
  // Distinto de liberacionEnCursoAt (que se pone a null al soltar el
  // lease): este NO se limpia nunca, así que es el que permite calcular
  // el backoff exponencial del reintento automático — sin él, la tarea
  // programada no podría distinguir "falló hace 10 segundos" de "falló
  // hace dos días" y martillearía Stripe cada 10 minutos.
  ultimoIntentoLiberacionAt DateTime?  @map("ultimo_intento_liberacion_at")
  // Marca de que ya se avisó a cliente y profesional de que esta
  // autorización está a punto de caducar (~7 días es el máximo que
  // Stripe mantiene un cargo autorizado sin capturar). Evita repetir el
  // aviso en cada pasada de la tarea programada.
  avisoCaducidadEnviadoAt DateTime?    @map("aviso_caducidad_enviado_at")

  serviceRequest        ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  presupuesto           Presupuesto    @relation(fields: [presupuestoId], references: [id])
  ampliacion            Ampliacion?    @relation(fields: [ampliacionId], references: [id])

  @@index([serviceRequestId])
  // Cola de pagos atascados (GET /admin/payments/stuck): filtra por
  // estado sobre toda la tabla payments. Sin índice sería sequential
  // scan, y es justo la consulta que un admin ejecuta cuando algo va
  // mal y necesita respuesta rápida.
  @@index([estado])
  @@map("payments")
}

// Bidireccional: cliente -> profesional y profesional -> cliente son
// dos filas independientes de la misma solicitud, una por cada
// "autor". El único constraint que tiene sentido ya no es
// serviceRequestId a secas (eso permitía solo UNA valoración total
// por solicitud) sino (serviceRequestId, autorId): cada parte puede
// valorar como mucho una vez, en su propio sentido.
model Review {
  id               String         @id @default(uuid())
  serviceRequestId String         @map("service_request_id")
  autorId          String         @map("autor_id")
  destinatarioId   String         @map("destinatario_id")
  puntuacion       Int
  comentario       String?
  createdAt        DateTime       @default(now()) @map("created_at")
  autor            User           @relation("AutorReview", fields: [autorId], references: [id])
  destinatario     User           @relation("DestinatarioReview", fields: [destinatarioId], references: [id])
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@unique([serviceRequestId, autorId])
  // destinatarioId: sin índice, listar "mis valoraciones" (getProfile,
  // getPublicProfile, getMisValoraciones — los tres filtran solo por
  // este campo) hacía sequential scan sobre toda la tabla reviews.
  @@index([destinatarioId])
  @@map("reviews")
}

model Dispute {
  id               String            @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  creadoPor        String            @map("creado_por")
  motivo           String
  motivoCategoria  MotivoReclamacion @default(otro) @map("motivo_categoria")
  fotosUrls        String[]          @default([]) @map("fotos_urls")
  estado           String            @default("abierta")
  resueltoPor      String?           @map("resuelto_por")
  resolucionNotas  String?           @map("resolucion_notas")
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id])

  @@index([serviceRequestId])
  @@map("disputes")
}

// Candidatura de un profesional a una solicitud "pendiente" — sustituye
// al antiguo "el primero que acepta gana". Único por (solicitud,
// profesional), mismo patrón que Review, para que no pueda postularse
// dos veces a la misma solicitud.
model Postulacion {
  id               String            @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  profesionalId    String            @map("profesional_id")
  mensaje          String?
  estado           EstadoPostulacion @default(pendiente)
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id])
  profesional      Professional      @relation(fields: [profesionalId], references: [userId])

  @@unique([serviceRequestId, profesionalId])
  @@map("postulaciones")
}

// Presupuesto real que el profesional envía tras ser elegido — sustituye
// al antiguo precioEstimado (adivinado por el cliente al crear la
// solicitud, nunca acordado con nadie). Dos modalidades: precio cerrado
// (monto fijo) o por horas (tarifa × horas estimadas, el importe que se
// autoriza en Stripe es ese techo). Sin @@unique a propósito, a
// diferencia de Postulacion: puede haber varias filas para el mismo
// profesional si el cliente rechaza una y llega una nueva — el control
// de "solo un pendiente a la vez" se hace en el controlador, no aquí.
model Presupuesto {
  id               String            @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  profesionalId    String            @map("profesional_id")
  tipo             TipoPresupuesto
  monto            Decimal? // solo tipo=cerrado
  tarifaHora       Decimal?          @map("tarifa_hora") // solo tipo=por_horas
  horasEstimadas   Decimal?          @map("horas_estimadas") // solo tipo=por_horas
  mensaje          String?
  // Declarativo: el profesional indica si su precio ya incluye IVA.
  // No afecta a ningún cálculo de comisión, es solo informativo para
  // el cliente en el desglose de pago.
  incluyeIva       Boolean           @default(false) @map("incluye_iva")
  estado           EstadoPresupuesto @default(pendiente)
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id])
  profesional      Professional      @relation(fields: [profesionalId], references: [userId])
  ampliaciones     Ampliacion[]
  pagos            Payment[]

  @@index([serviceRequestId, estado])
  @@map("presupuestos")
}

// Petición del profesional para sumar más horas a un presupuesto
// "por_horas" ya aceptado, cuando el trabajo se alarga más de lo
// previsto — nunca se cobra el exceso fuera de la app. Mismo patrón
// pendiente/aceptado/rechazado que Presupuesto (reutiliza el mismo
// enum). Al aceptar, se autoriza una autorización de Stripe NUEVA por
// el importe adicional exacto (ver Payment.ampliacionId) — no se
// modifica la autorización original, así funciona igual en cualquier
// tarjeta/banco sin depender de la autorización incremental nativa de
// Stripe, que no todas las tarjetas europeas soportan de forma fiable.
// Dos modalidades, igual que Presupuesto: si el presupuesto es
// "por_horas", horasAdicionales; si es "cerrado", montoAdicional
// directo (ej. "+40€, hay que sustituir una válvula"). Exactamente una
// de las dos viene rellena, según el tipo del presupuesto al que
// pertenece — se valida en el controlador, no aquí.
model Ampliacion {
  id               String            @id @default(uuid())
  presupuestoId    String            @map("presupuesto_id")
  horasAdicionales Decimal?          @map("horas_adicionales")
  montoAdicional   Decimal?          @map("monto_adicional")
  mensaje          String?
  estado           EstadoPresupuesto @default(pendiente)
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  presupuesto      Presupuesto       @relation(fields: [presupuestoId], references: [id])
  pagos            Payment[]

  @@map("ampliaciones")
}

// Cierre de un trabajo "por_horas": el profesional declara las horas
// reales, pero el pago no se libera hasta que el cliente lo confirma
// (mismo patrón pendiente/aceptado/rechazado). Si el cliente no está
// de acuerdo, no hay renegociación automática aquí — se resuelve por
// chat o, si no hay acuerdo, con una reclamación (createDispute, ya
// existente). Los trabajos "cerrado" no pasan por esta tabla — se
// completan y liberan directo, como en la Fase 1.
model CierreHoras {
  id               String            @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  horasReales      Decimal           @map("horas_reales")
  estado           EstadoPresupuesto @default(pendiente)
  createdAt        DateTime          @default(now()) @map("created_at")
  resueltaAt       DateTime?         @map("resuelta_at")
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id])

  @@index([serviceRequestId])
  @@map("cierres_horas")
}

// Registro de cada archivo subido (auditoría B4).
//
// LA PIEZA QUE FALTABA: antes, `uploadPhoto` escribía `<uuid>.jpg` en
// disco y devolvía una URL, y a partir de ahí el servidor ya no podía
// distinguir un DNI escaneado de la foto de una cocina. Sin esa
// información no había forma de aplicar reglas de acceso distintas, ni
// de borrar los archivos de un usuario al eliminar su cuenta, ni de
// saber qué había quedado huérfano en el disco. De esa única carencia
// salían los tres problemas: sin control de acceso, sin borrado
// (incumpliendo el RGPD Art. 17) y sin auditoría.
//
// Clasificar al ESCRIBIR es lo que permite verificar al LEER.
model ArchivoSubido {
  id            String      @id @default(uuid())
  // Nombre en disco (`<uuid>.jpg`). Es la clave por la que entra
  // `GET /uploads/:archivo`, de ahí el @unique.
  nombreArchivo String      @unique @map("nombre_archivo")
  tipo          TipoArchivo
  propietarioId String      @map("propietario_id")
  // Las fotos se suben ANTES de que exista la solicitud (el asistente
  // sube y luego crea), así que esto se rellena al crear la solicitud o
  // la reclamación. Es lo que permite comprobar "¿eres participante?"
  // con una consulta indexada exacta en vez de un LIKE sobre un array.
  serviceRequestId String?  @map("service_request_id")
  bytes         Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at")
  // Borrado lógico: la fila se marca aquí y la tarea programada
  // `limpiar-archivos-huerfanos` borra el fichero del disco después. Así
  // el borrado de cuenta responde al instante y el trabajo de disco (que
  // puede fallar) no bloquea al usuario ni deja la BD inconsistente.
  eliminadoAt   DateTime?   @map("eliminado_at")

  propietario   User        @relation(fields: [propietarioId], references: [id])

  @@index([propietarioId])
  @@index([serviceRequestId])
  // La tarea de limpieza filtra por esto en cada pasada.
  @@index([eliminadoAt])
  @@map("archivos_subidos")
}

// Estado persistido de cada tarea programada (ver src/jobs/). Una fila
// por tarea, creada sola la primera vez que se ejecuta.
//
// El calendario vive AQUÍ y no en la memoria del proceso a propósito:
// "¿le toca correr a esta tarea?" se calcula desde `ultimaEjecucionAt`,
// así que un redeploy de Render (que reinicia el proceso varias veces al
// día) no vuelve a disparar todas las tareas desde cero. Y `bloqueadoHasta`
// es lo que impide que dos instancias del backend ejecuten la misma tarea
// a la vez si algún día se escala horizontalmente — mismo patrón de lease
// con expiración que la liberación de pagos, no un mecanismo distinto.
model TareaProgramada {
  nombre             String    @id
  bloqueadoHasta     DateTime? @map("bloqueado_hasta")
  ultimaEjecucionAt  DateTime? @map("ultima_ejecucion_at")
  // Resumen legible de la última pasada, para el panel de admin
  // (ej. "3 pagos reintentados, 1 fallo").
  ultimoResultado    String?   @map("ultimo_resultado")
  ultimoError        String?   @map("ultimo_error")
  ejecuciones        Int       @default(0)
  // Se reinicia a 0 en cada ejecución correcta — un valor alto es la
  // señal de que algo lleva roto tiempo, no de un fallo puntual.
  fallosConsecutivos Int       @default(0) @map("fallos_consecutivos")

  @@map("tareas_programadas")
}

// Auditoría centralizada del panel admin (Bloque 4). `adminId`/`entidadId`
// son strings sueltos, no relaciones — mismo patrón que `creadoPor`/
// `resueltoPor` en Dispute o `verificadoPor` en Professional: no vale la
// pena una FK para un campo que solo se lee, nunca se hace join sobre él.
// `estadoAnterior`/`estadoNuevo` son nullable porque no toda acción tiene
// una transición de estado clara (ej. una futura acción que solo lee).
model AdminAction {
  id             String   @id @default(uuid())
  adminId        String   @map("admin_id")
  accion         String
  entidadTipo    String   @map("entidad_tipo")
  entidadId      String   @map("entidad_id")
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String?  @map("estado_nuevo")
  detalle        String?
  createdAt      DateTime @default(now()) @map("created_at")

  // Consultas reales del panel: "qué hizo este admin" y "qué le pasó a
  // esta entidad", en ese orden de frecuencia esperada.
  @@index([adminId, createdAt])
  @@index([entidadTipo, entidadId])
  @@map("admin_actions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

// Qué es cada archivo subido (auditoría B4). El orden va de menos a
// más sensible, y determina quién puede leerlo — ver `puedeVerArchivo`
// en archivo.controller.ts.
enum TipoArchivo {
  // Visible para cualquier usuario autenticado: los perfiles de
  // profesional son navegables por diseño, es una foto que su dueño
  // publica a propósito.
  foto_perfil
  // Solo los participantes de esa solicitud (y un admin): son fotos del
  // interior de la casa de alguien.
  foto_solicitud
  foto_disputa
  // SOLO el propietario y un admin. Nunca nadie más, bajo ningún
  // concepto. Un DNI o un NIE es un dato de identificación nacional.
  documento_identidad
  certificado
  seguro_rc
}

