// Roadmap económico punto 4: HogarSOS no verifica la situación fiscal
// del profesional ni decide cuál le corresponde — solo registra la que
// el propio profesional declara. Enum cerrado a propósito (3 opciones
// aprobadas para la versión inicial en España); ampliarlo a futuro es
// solo añadir un valor aquí + una migración, no toca el resto del flujo.
enum TipoProfesional {
  autonomo
  empresa
  persona_fisica
}

enum EstadoSolicitud {
  pendiente
  aceptada
  en_progreso
  completada
  cancelada
  disputada
}

enum EstadoPago {
  // PaymentIntent ya creado en Stripe pero el cliente todavía no ha
  // confirmado el Payment Sheet (o lo canceló/falló antes de confirmar).
  // Antes esta fila nacía directamente como 'retenido', lo que hacía que
  // la solicitud apareciera como "pagada" para cliente y profesional aun
  // cuando Stripe nunca llegó a autorizar nada real (comprobado: el
  // PaymentIntent se quedaba en 'requires_payment_method'/'Incompleto'
  // sin método de pago adjunto). Solo pasa a 'retenido' cuando el webhook
  // payment_intent.amount_capturable_updated confirma la autorización de
  // verdad — ver createEscrowPaymentIntent y stripeWebhook.
  pendiente
  retenido
  // Estado intermedio real que antes no se representaba: el dinero YA
  // salió de la tarjeta del cliente (captura hecha en Stripe) pero
  // todavía no ha llegado a la cuenta Connect del profesional. Antes
  // este estado existía en la realidad pero era invisible para el
  // sistema — y es exactamente donde se perdía el dinero cuando el
  // transfer fallaba. Ahora es consultable (GET /admin/payments/stuck)
  // y reanudable.
  capturado
  liberado
  reembolsado
  fallido
}

