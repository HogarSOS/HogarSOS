# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL. Fija connection_limit explícitamente — sin
# él, Prisma calcula el pool como num_cpus*2+1, y en un contenedor
# puede ver muchos más CPUs de los que el plan realmente asigna,
# abriendo muchas más conexiones de las que el plan de Postgres admite.
DATABASE_URL="postgresql://usuario:password@localhost:5432/hogarsos?connection_limit=5&pool_timeout=10"

# Firebase (Auth, push, chat)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (pagos, modelo marketplace)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comisión de plataforma (cliente paga base+%, profesional recibe base-%).
# Valor de producción: 5 / 0 — el cliente paga un 5% de "Gastos de gestión"
# y el profesional recibe el 100% de lo que cotizó.
PLATFORM_COMMISSION_CLIENT_PERCENT=5
PLATFORM_COMMISSION_PROFESSIONAL_PERCENT=0

# URL base de la app (usada en redirects de Stripe Connect onboarding).
# Debe ser el dominio real del backend (hogarsos.es).
APP_BASE_URL=https://hogarsos.es

# Feature flag: si es "false", ningún profesional queda bloqueado por su
# estado de verificación (disponibilidad, aceptar solicitudes, búsqueda,
# perfil público). La cola de revisión del admin sigue funcionando igual.
REQUIRE_PROFESSIONAL_VERIFICATION=true

# Correo (IONOS - soporte@hogarsos.es)
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hogar SOS <soporte@hogarsos.es>"

# Tareas programadas (src/jobs/): reintento automático de pagos
# atascados y aviso de autorizaciones de Stripe a punto de caducar.
# Corren dentro del propio servicio web, con lock en base de datos.
# Ponlo a "false" para arrancar el backend sin ellas (útil en local,
# para no tocar Stripe sin querer mientras se desarrolla otra cosa).
SCHEDULER_ENABLED=true
