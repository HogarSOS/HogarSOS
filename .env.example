# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/hogarsos"

# Firebase (Auth, push, chat)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (pagos, modelo marketplace)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comisión de plataforma
PLATFORM_COMMISSION_PERCENT=18

# URL base de la app (usada en redirects de Stripe Connect onboarding)
APP_BASE_URL=https://hogarsos.com

# Feature flag: si es "false", ningún profesional queda bloqueado por su
# estado de verificación (disponibilidad, aceptar solicitudes, búsqueda,
# perfil público). La cola de revisión del admin sigue funcionando igual.
REQUIRE_PROFESSIONAL_VERIFICATION=true
