rules_version = '2';

// Reglas de seguridad de Firestore para el chat de hogarSOS.
// Solo el cliente y el profesional de UNA solicitud concreta pueden
// leer/escribir sus mensajes — nunca un tercero, ni siquiera otro
// cliente o profesional de la plataforma.
//
// acceptServiceRequest (serviceRequest.controller.ts) sincroniza los
// UIDs de Firebase de ambas partes a /service_requests/{id} en el
// momento de aceptar — es lo que estas reglas necesitan para
// funcionar. Publicadas en el proyecto "hogarsos" el 2026-07-29.

service cloud.firestore {
  match /databases/{database}/documents {
    match /service_requests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.clienteFirebaseUid ||
         request.auth.uid == resource.data.profesionalFirebaseUid);

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/service_requests/$(requestId)).data.clienteFirebaseUid ||
           request.auth.uid == get(/databases/$(database)/documents/service_requests/$(requestId)).data.profesionalFirebaseUid);
        // autorId debe ser el propio UID de quien escribe: antes el
        // cliente Flutter mandaba el id de Postgres (AppUser.id) como
        // autorId, así que esta comprobación era imposible de aplicar
        // sin romper el envío de mensajes. Ahora que el cliente manda
        // el UID de Firebase real (ver chat_screen.dart), exigirlo
        // aquí evita que un participante autorizado del chat pueda
        // enviar mensajes suplantando al otro.
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.autorId &&
          (request.auth.uid == get(/databases/$(database)/documents/service_requests/$(requestId)).data.clienteFirebaseUid ||
           request.auth.uid == get(/databases/$(database)/documents/service_requests/$(requestId)).data.profesionalFirebaseUid);
        allow update, delete: if false; // los mensajes son inmutables
      }
    }
  }
}
